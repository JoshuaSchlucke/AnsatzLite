module src/optimize/basic

import random
import list
import array

record SearchResult(params: Array[Double], value: Double)


def linspace(min: Double, max: Double, steps: Int): Array[Double] = {
  if (steps <= 1) {
    val arr = array(1, min)
    arr
  } else {
    val step = (max - min) / (steps - 1).toDouble
    array::build(steps) { i => min + (i.toDouble * step) }
  }
}


def listGet(xs: List[Double], index: Int, default: Double): Double = xs match {
  case Nil() => default
  case Cons(x, rest) => if (index == 0) x else listGet(rest, index - 1, default)
}

def gridSearch(p: Int, steps: Int, gammaMin: Double, gammaMax: Double, betaMin: Double, betaMax: Double)
  { objective: Array[Double] => Double }
  : SearchResult = {
  val gammas = linspace(gammaMin, gammaMax, steps)
  val betas = linspace(betaMin, betaMax, steps)
  val total = p * 2

  def searchLayer(i: Int, gsAcc: List[Double], bsAcc: List[Double])
    : SearchResult = {
    if (i == p) {
      val gsList = gsAcc.reverse
      val bsList = bsAcc.reverse
      val params = array::build(total) { idx =>
        if (idx < p) listGet(gsList, idx, 0.0)
        else listGet(bsList, idx - p, 0.0)
      }
      val value = objective(params)
      SearchResult(params, value)
    } else {
      var best = SearchResult(array(0, 0.0), -1000000000000.0)
      gammas.foreach { g =>
        betas.foreach { b =>
          val res = searchLayer(i + 1, Cons(g, gsAcc), Cons(b, bsAcc))
          if (res.value > best.value) { best = res }
        }
      }
      best
    }
  }

  searchLayer(0, Nil(), Nil())
}

def clamp(x: Double, lo: Double, hi: Double): Double =
  if (x < lo) lo else if (x > hi) hi else x


def localSearch(p: Int, init: Array[Double], rounds: Int, step0: Double, decay: Double, gammaMin: Double, gammaMax: Double, betaMin: Double, betaMax: Double)
  { objective: Array[Double] => Double }
  : SearchResult = {
  val total = p * 2
  var params = array::build(total) { i =>
    if (i < init.size) init.get(i) else 0.0
  }
  var best = objective(params)
  var step = step0
  var round = 0
  while (round < rounds) {
    var improved = false
    var i = 0
    while (i < total) {
      val cur = params.get(i)
      val lo = if (i < p) gammaMin else betaMin
      val hi = if (i < p) gammaMax else betaMax
      val up = clamp(cur + step, lo, hi)
      val down = clamp(cur - step, lo, hi)

      var bestHere = best
      var bestParams = params

      if (up != cur) {
        val cand = array::copy(params)
        cand.set(i, up)
        val v = objective(cand)
        if (v > bestHere) { bestHere = v; bestParams = cand }
      }

      if (down != cur) {
        val cand = array::copy(params)
        cand.set(i, down)
        val v = objective(cand)
        if (v > bestHere) { bestHere = v; bestParams = cand }
      }

      if (bestHere > best) {
        best = bestHere
        params = bestParams
        improved = true
      }

      i = i + 1
    }

    if (not(improved)) {
      step = step * decay
    }
    round = round + 1
  }
  SearchResult(params, best)
}


def randomSearch(p: Int, samples: Int, seed: Int, gammaMin: Double, gammaMax: Double, betaMin: Double, betaMax: Double)
  { objective: Array[Double] => Double }
  : SearchResult = {
  val total = p * 2
  var best = SearchResult(array(0, 0.0), -1000000000000.0)
  seed.minstd {
    var i = 0
    while (i < samples) {
      val params = array(total, 0.0)
      var j = 0
      while (j < p) {
        val g = gammaMin + (gammaMax - gammaMin) * random::randomDouble()
        val b = betaMin + (betaMax - betaMin) * random::randomDouble()
        params.set(j, g)
        params.set(j + p, b)
        j = j + 1
      }
      val value = objective(params)
      if (value > best.value) { best = SearchResult(params, value) }
      i = i + 1
    }
  }
  best
}
