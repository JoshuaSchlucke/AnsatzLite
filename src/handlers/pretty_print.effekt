module src/handlers/pretty_print

import list
import src/qaoa/effects
import src/handlers/trace


def withPrettyPrint { prog: => Double / {prepare, cost, costEdge, costPredicate, mixer, expect} }: List[String] =
  list::collect[String] {
    try { prog(); () }
    with prepare { n =>
      do emit("prepare " ++ n.show)
      resume(())
    }
    with cost { gamma =>
      do emit("cost " ++ gamma.show)
      resume(())
    }
    with costEdge { (gamma, u, v, w) =>
      do emit("costEdge " ++ gamma.show ++ " " ++ u.show ++ " " ++ v.show ++ " " ++ w.show)
      resume(())
    }
    with costPredicate { gamma =>
      resume { {predicate} =>
        do emit("costPredicate " ++ gamma.show)
        ()
      }
    }
    with mixer { beta =>
      do emit("mixer " ++ beta.show)
      resume(())
    }
    with expect {
      resume { {value} =>
        do emit("expect")
        0.0
      }
    }
  }
